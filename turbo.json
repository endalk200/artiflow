{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "stream",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": [
				"ARTIFLOW_PUBLIC_BASE_URL",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"GITHUB_CLIENT_ID",
				"GITHUB_CLIENT_SECRET",
				"NEXT_PUBLIC_APP_URL"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"],
			"passThroughEnv": [
				"OTEL_EXPORTER_OTLP_ENDPOINT",
				"OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
				"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
				"OTEL_SDK_DISABLED",
				"OTEL_SERVICE_NAME"
			]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"],
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"test:storybook": {
			"cache": false
		},
		"storybook": {
			"cache": false,
			"persistent": true
		},
		"build-storybook": {
			"dependsOn": ["^build"],
			"outputs": ["storybook-static/**"]
		},
		"test:integration": {
			"dependsOn": ["^test:integration"],
			"env": ["DATABASE_TEST_URL"],
			"cache": false
		},
		"db:generate": {
			"env": ["DATABASE_URL"],
			"outputs": ["drizzle/**"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test:e2e:headed": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test:e2e:ui": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"GITHUB_CLIENT_ID",
				"GITHUB_CLIENT_SECRET",
				"OTEL_EXPORTER_OTLP_ENDPOINT",
				"OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
				"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
				"OTEL_SDK_DISABLED",
				"OTEL_SERVICE_NAME"
			]
		}
	}
}
