{
	"name": "@app/database",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./generated/client": "./src/generated/client.ts"
	},
	"scripts": {
		"db:generate": "prisma generate --schema prisma/schema.prisma",
		"db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
		"db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
		"db:migrate:reset": "prisma migrate reset --schema prisma/schema.prisma",
		"db:studio": "prisma studio --browser none",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.8.0",
		"@prisma/client": "7.8.0",
		"dotenv": "^17.2.3",
		"effect": "4.0.0-beta.69",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@app/biome-config": "*",
		"@app/typescript-config": "*",
		"@effect/vitest": "4.0.0-beta.69",
		"@types/node": "^22.15.3",
		"@types/pg": "^8.15.6",
		"prisma": "7.8.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
