{
	"name": "@app/ui",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./lib/*": "./src/lib/*.ts"
	},
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#hooks/*": "./src/hooks/*.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"react": "^19.2.6",
		"shadcn": "^4.8.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@app/biome-config": "*",
		"@app/typescript-config": "*",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@storybook/nextjs-vite": "^10.4.3",
		"@types/react": "19.2.2",
		"@vitejs/plugin-react": "^6.0.2",
		"jsdom": "^29.1.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
