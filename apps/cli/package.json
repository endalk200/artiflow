{
	"name": "artiflow",
	"version": "0.4.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/endalk200/artiflow.git",
		"directory": "apps/cli"
	},
	"devDependencies": {
		"@app/api-contract": "*",
		"@app/telemetry-config": "*",
		"@app/typescript-config": "*",
		"@effect/platform-node": "4.0.0-rc.109",
		"@effect/vitest": "4.0.0-rc.109",
		"@types/node": "^26.2.0",
		"effect": "4.0.0-rc.109",
		"toml": "^5.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"bin": {
		"artiflow": "dist/bin.js"
	},
	"description": "Command-line interface for Artiflow",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist/bin.js",
		"LICENSE",
		"README.md"
	],
	"license": "MIT",
	"private": false,
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "bun run ../../scripts/build-cli.ts",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"test": "vitest run src --passWithNoTests"
	},
	"type": "module"
}
