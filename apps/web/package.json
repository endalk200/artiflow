	"scripts": {
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"check-types": "next typegen && tsc --noEmit",
		"test": "vitest run --project unit --passWithNoTests",
		"test:integration": "vitest run --project integration --passWithNoTests",
		"test:storybook": "vitest run --project \"storybook:$PWD/.storybook\"",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"e2e:server": "bun run e2e/server.ts",
		"playwright:install": "playwright install chromium",
		"playwright:install:ci": "playwright install --with-deps chromium",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"db:migrate:reset": "drizzle-kit migrate:reset --config drizzle.config.ts",
		"db:push": "drizzle-kit push --config drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config drizzle.config.ts"
	}
}
