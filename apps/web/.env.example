# Server-only OTLP/HTTP base URL. Artiflow appends /v1/traces and /v1/logs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Optional full-URL signal overrides and kill switch.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
# OTEL_SERVICE_NAME=artiflow-web
# OTEL_SDK_DISABLED=true

DATABASE_URL="postgresql://artiflow:artiflow@localhost:5432/artiflow"
ARTIFLOW_PUBLIC_BASE_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
