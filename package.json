{
	"name": "app",
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"esbuild": "0.28.2",
		"js-yaml": "5.4.1",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2",
		"undici": "8.10.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"artiflow": "bun run apps/cli/src/bin.ts --",
		"build": "turbo run build",
		"build-storybook": "turbo run build-storybook",
		"changeset": "changeset",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"release:audit": "bun run scripts/audit-release.ts",
		"release:smoke": "bun run scripts/smoke-npm-package.ts",
		"release:verify": "bun run scripts/verify-npm-package.ts",
		"format:check": "biome format .",
		"format:write": "biome format . --write",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:storybook": "turbo run test:storybook",
		"test:integration": "turbo run test:integration",
		"db:generate": "turbo run db:generate",
		"db:migrate": "bun --filter web db:migrate",
		"db:migrate:reset": "bun --filter web db:migrate:reset",
		"db:push": "bun --filter web db:push",
		"db:studio": "bun --filter web db:studio",
		"storybook": "turbo run storybook",
		"test:e2e": "turbo run test:e2e",
		"test:e2e:headed": "turbo run test:e2e:headed",
		"test:e2e:ui": "turbo run test:e2e:ui",
		"sync-cli-version": "bun run scripts/sync-cli-version.ts",
		"version-packages": "changeset version && bun run sync-cli-version"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/domains/*",
		"packages/shared/*"
	],
	"overrides": {
		"@hono/node-server": "1.19.14",
		"hono": "4.12.30",
		"postcss": "8.5.26",
		"protobufjs": "7.6.5"
	}
}
